<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app": the published app folder (release.yml, "Sign app").
     Only HomeWindow's own files are signed; the .NET runtime is signed by Microsoft already. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file-set product-name="HomeWindow" product-version="${version}">
      <include path="HomeWindow.exe" />
      <include path="HomeWindow.dll" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
