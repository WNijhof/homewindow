<Window x:Class="HomeWindow.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:HomeWindow.Core"
        xmlns:local="clr-namespace:HomeWindow.Views"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="HomeWindow" Width="384" Height="640"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="Transparent" FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextBrush}" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0" UseAeroCaptionButtons="False" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- The tile sizes come from Theme.Tiles, see ApplyView -->
        <sys:Double x:Key="FlowHeight">54</sys:Double>
        <sys:Double x:Key="FlowWidth">169</sys:Double>
    </Window.Resources>

    <Grid x:Name="Root" Background="{DynamicResource BackdropBrush}">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Margin="16,14,10,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="LockToggle" Style="{StaticResource IconBtn}" Click="LockToggle_Click" Visibility="Collapsed" />
                <Button Style="{StaticResource IconBtn}" Content="&#xE72C;" ToolTip="{c:T Vernieuwen}" Click="Refresh_Click" />
                <Button Style="{StaticResource IconBtn}" Content="&#xE8A7;" ToolTip="{c:T 'HomeWindow openen'}" Click="Open_Click" />
                <Button Style="{StaticResource IconBtn}" Content="&#xE713;" ToolTip="{c:T Instellingen}" Click="Settings_Click" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding HomeyName}" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{DynamicResource GoodBrush}" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Sub}" MaxWidth="240" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Weather, energy and who is home -->
        <Grid Grid.Row="1" Margin="16,2,16,8" x:Name="InfoStrip">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="WeatherPart" Orientation="Horizontal" Margin="0,0,14,0" DataContext="{Binding Weather}"
                        Visibility="{Binding HasData, Converter={StaticResource Visible}}" ToolTip="{Binding Description}">
                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="18" Foreground="{DynamicResource SolarBrush}" Margin="0,0,6,0" />
                <TextBlock Text="{Binding Temperature}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel x:Name="EnergyPart" Grid.Column="1" Orientation="Horizontal" DataContext="{Binding Energy}"
                        Visibility="{Binding HasData, Converter={StaticResource Visible}}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" ToolTip="{c:T 'Verbruik nu'}" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" FontSize="13" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding HomeText}" FontSize="12.5" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" ToolTip="{c:T Zon}" Margin="0,0,12,0" Visibility="{Binding HasSolar, Converter={StaticResource Visible}}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE706;" FontSize="13" Foreground="{DynamicResource SolarBrush}" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding SolarText}" FontSize="12.5" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" ToolTip="{Binding GridLabel}" Visibility="{Binding HasGrid, Converter={StaticResource Visible}}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="13" Foreground="{DynamicResource GridBrush}" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding GridText}" Style="{StaticResource GridValue}" FontSize="12.5" />
                </StackPanel>
            </StackPanel>
            <ItemsControl Grid.Column="2" ItemsSource="{Binding Users}" ItemTemplate="{StaticResource UserChip}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Grid>

        <!-- Tabs and search -->
        <StackPanel Grid.Row="2" Margin="16,0,16,8">
            <Border Style="{StaticResource SegmentBar}">
                <UniformGrid Columns="4">
                    <RadioButton x:Name="TabFavorites" Style="{StaticResource Segment}" Content="{c:T Favorieten}" GroupName="FlyTab" Checked="Tab_Checked" Tag="favorites" />
                    <RadioButton x:Name="TabRooms" Style="{StaticResource Segment}" Content="{c:T Kamers}" GroupName="FlyTab" Checked="Tab_Checked" Tag="rooms" />
                    <RadioButton x:Name="TabFlows" Style="{StaticResource Segment}" Content="{c:T Flows}" GroupName="FlyTab" Checked="Tab_Checked" Tag="flows" />
                    <RadioButton x:Name="TabMoods" Style="{StaticResource Segment}" Content="{c:T Sferen}" GroupName="FlyTab" Checked="Tab_Checked" Tag="moods" />
                </UniformGrid>
            </Border>
            <Grid Margin="0,8,0,0">
                <TextBox x:Name="SearchBox" Padding="30,6,30,6" TextChanged="Search_Changed" />
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="12" HorizontalAlignment="Left" Margin="11,0,0,0" Foreground="{DynamicResource SubTextBrush}" IsHitTestVisible="False" />
                <TextBlock x:Name="SearchHint" Text="{c:T Zoeken}" Style="{StaticResource Sub}" FontSize="13" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                <Button x:Name="ViewToggle" Style="{StaticResource IconBtn}" Width="26" Height="26" FontSize="12" HorizontalAlignment="Right" Margin="0,0,3,0"
                        Content="&#xE80A;" Click="ViewToggle_Click" ToolTip="{c:T 'Lijst of raster'}" />
            </Grid>
        </StackPanel>

        <!-- Content -->
        <ScrollViewer x:Name="Scroller" Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="16,0,10,12" Margin="0,0,6,0">
            <Grid>
                <!-- Favourites -->
                <StackPanel x:Name="FavoritesPanel">
                    <ItemsControl ItemsSource="{Binding FavoriteDevices}" ItemTemplate="{DynamicResource FlyoutDeviceTemplate}"
                                  ItemsPanel="{DynamicResource FlyoutDevicePanel}" Margin="{DynamicResource FlyoutItemsMargin}" />
                    <TextBlock Text="{c:T Flows}" Style="{StaticResource Heading}" Margin="2,10,0,4"
                               Visibility="{Binding FavoriteFlows.Count, Converter={StaticResource Visible}}" />
                    <ItemsControl ItemsSource="{Binding FavoriteFlows}" ItemTemplate="{StaticResource FlowTile}" Margin="-4,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <StackPanel Margin="10,40,10,0" HorizontalAlignment="Center" x:Name="NoFavorites">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE734;" FontSize="28" Foreground="{DynamicResource FaintTextBrush}" />
                        <TextBlock Text="{c:T 'Nog geen favorieten'}" Style="{StaticResource Body}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" />
                        <TextBlock Text="{c:T 'Klik met de rechtermuisknop op een apparaat, of op de ster bij een flow, om het hier te zetten.'}"
                                   Style="{StaticResource Body}" Foreground="{DynamicResource SubTextBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Text="{c:T 'Dit zijn de favorieten van HomeWindow zelf, los van de favorieten in de Homey-app.'}"
                                   Style="{StaticResource Sub}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <Button Style="{StaticResource AccentBtn}" Content="{c:T 'Favorieten van Homey overnemen'}" HorizontalAlignment="Center" Margin="0,14,0,0" Click="ImportFavorites_Click" />
                        <Button Style="{StaticResource Btn}" Content="{c:T 'Alle apparaten per kamer'}" HorizontalAlignment="Center" Margin="0,14,0,0" Click="ShowRooms_Click" />
                    </StackPanel>
                </StackPanel>

                <!-- Rooms -->
                <StackPanel x:Name="RoomsPanel" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,-4,0,2">
                    <Button Style="{StaticResource IconBtn}" Width="28" Height="28" FontSize="13" Content="&#xE70E;" ToolTip="{c:T 'Alles inklappen'}" Command="{Binding CollapseAllCommand}" />
                    <Button Style="{StaticResource IconBtn}" Width="28" Height="28" FontSize="13" Content="&#xE70D;" ToolTip="{c:T 'Alles uitklappen'}" Command="{Binding ExpandAllCommand}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type c:ZoneGroup}">
                            <StackPanel Margin="0,0,0,4">
                                <ToggleButton Style="{StaticResource GroupHeader}" IsChecked="{Binding IsExpanded}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{Binding Count}" Style="{StaticResource Sub}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ToggleButton>
                                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{DynamicResource FlyoutDeviceTemplate}" ItemsPanel="{DynamicResource FlyoutDevicePanel}"
                                              Margin="{DynamicResource FlyoutItemsMargin}" Visibility="{Binding IsExpanded, Converter={StaticResource Visible}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>

                <!-- Flows -->
                <StackPanel x:Name="FlowsPanel" Visibility="Collapsed">
                    <TextBlock Text="{Binding FlowsError}" Style="{StaticResource Body}" Foreground="{DynamicResource WarnBrush}" Margin="2,0,0,8"
                               Visibility="{Binding FlowsError, Converter={StaticResource Visible}}" />
                    <ItemsControl x:Name="FlowGroupsList" ItemTemplate="{StaticResource FlowGroupTemplate}" />
                </StackPanel>

                <!-- Moods -->
                <StackPanel x:Name="MoodsPanel" Visibility="Collapsed">
                    <TextBlock Text="{Binding MoodsError}" Style="{StaticResource Body}" Foreground="{DynamicResource WarnBrush}" Margin="2,0,0,8"
                               Visibility="{Binding MoodsError, Converter={StaticResource Visible}}" />
                    <ItemsControl x:Name="MoodsList" ItemTemplate="{StaticResource MoodTile}" Margin="-4,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Text="{c:T 'Geen sferen gevonden'}" Style="{StaticResource Sub}" HorizontalAlignment="Center" Margin="0,30,0,0"
                               Visibility="{Binding Moods.Count, Converter={StaticResource Visible}, ConverterParameter=not}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Not set up or not connected -->
        <Border x:Name="OfflinePanel" Grid.Row="1" Grid.RowSpan="3" Background="{DynamicResource BackdropBrush}" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" Margin="32,0">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" FontSize="36" Foreground="{DynamicResource FaintTextBrush}" />
                <TextBlock x:Name="OfflineTitle" Text="{c:T 'Niet verbonden'}" Style="{StaticResource Body}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Body}" Foreground="{DynamicResource SubTextBrush}" TextAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Button Style="{StaticResource Btn}" Content="{c:T 'Opnieuw proberen'}" Click="Refresh_Click" Margin="0,0,8,0" />
                    <Button Style="{StaticResource AccentBtn}" Content="{c:T Instellingen}" Click="Settings_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- One device, over the list -->
        <Border x:Name="DetailPanel" Grid.Row="1" Grid.RowSpan="3" Background="{DynamicResource BackdropBrush}" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Top" Style="{StaticResource Btn}" HorizontalAlignment="Left" Margin="16,0,0,8" Padding="10,5" Click="CloseDetail_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="{c:T Terug}" FontSize="12.5" />
                    </StackPanel>
                </Button>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0,10,16" Margin="0,0,6,0">
                    <ContentPresenter x:Name="DetailContent" ContentTemplate="{StaticResource DeviceDetail}" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Errors -->
        <Border Grid.Row="3" VerticalAlignment="Bottom" Margin="16,0,16,14" CornerRadius="10" Padding="12,9" Background="{DynamicResource AlarmBrush}"
                Visibility="{Binding Error, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding Error}" Foreground="White" FontSize="12.5" TextWrapping="Wrap" />
        </Border>

        <local:LockOverlay x:Name="LockCover" Grid.RowSpan="4" />
    </Grid>
</Window>
