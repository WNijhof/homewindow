<UserControl x:Class="HomeWindow.Views.Pages.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:HomeWindow.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,22,22,28">
        <StackPanel>
            <TextBlock x:Name="Greeting" Style="{StaticResource Title}" />
            <TextBlock x:Name="DateText" Style="{StaticResource Sub}" FontSize="13" Margin="0,2,0,16" />

            <WrapPanel>
                <!-- Weather -->
                <Border Style="{StaticResource Card}" Width="300" Margin="0,0,12,12" DataContext="{Binding Weather}"
                        Visibility="{Binding HasData, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="34" Foreground="{DynamicResource SolarBrush}" Margin="0,0,14,0" />
                            <StackPanel>
                                <TextBlock Text="{Binding Temperature}" Style="{StaticResource Big}" FontSize="30" />
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Sub}" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding Details}" Style="{StaticResource Sub}" Margin="0,8,0,0" Visibility="{Binding Details, Converter={StaticResource Visible}}" />
                        <ItemsControl ItemsSource="{Binding Hours}" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type c:HourVM}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Time}" Style="{StaticResource Sub}" FontSize="10.5" HorizontalAlignment="Center" />
                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="13" Margin="0,4" Foreground="{DynamicResource SubTextBrush}" />
                                        <TextBlock Text="{Binding Temperature}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Energy now -->
                <Border Style="{StaticResource Card}" Width="300" Margin="0,0,12,12" DataContext="{Binding Energy}"
                        Visibility="{Binding HasData, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <TextBlock Text="{c:T 'Verbruik nu'}" Style="{StaticResource Sub}" />
                        <TextBlock Text="{Binding HomeText}" Style="{StaticResource Big}" FontSize="30" />
                        <UniformGrid Columns="2" Margin="0,10,0,0">
                            <StackPanel Visibility="{Binding HasSolar, Converter={StaticResource Visible}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE706;" FontSize="12" Foreground="{DynamicResource SolarBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="{c:T Zon}" Style="{StaticResource Sub}" />
                                </StackPanel>
                                <TextBlock Text="{Binding SolarText}" FontSize="15" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding HasGrid, Converter={StaticResource Visible}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="12" Foreground="{DynamicResource GridBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding GridLabel}" Style="{StaticResource Sub}" />
                                </StackPanel>
                                <TextBlock Text="{Binding GridText}" FontSize="15" FontWeight="SemiBold" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Who is home -->
                <Border Style="{StaticResource Card}" Width="300" Margin="0,0,12,12" Visibility="{Binding Users.Count, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <TextBlock Text="{c:T Aanwezigheid}" Style="{StaticResource Sub}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Users}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type c:UserVM}">
                                    <DockPanel Margin="0,3">
                                        <ContentPresenter DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource UserChip}" Margin="0,0,6,0" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}" Style="{StaticResource Sub}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Things that need attention -->
                <Border Style="{StaticResource Card}" Width="300" Margin="0,0,12,12" Visibility="{Binding LowBatteryCount, Converter={StaticResource Visible}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE850;" FontSize="24" Foreground="{DynamicResource WarnBrush}" Margin="0,0,14,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding LowBatteryText}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{c:T 'Bekijk ze onder Batterijen'}" Style="{StaticResource Sub}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </WrapPanel>

            <!-- Favourites -->
            <TextBlock Text="{c:T Favorieten}" Style="{StaticResource Heading}" />
            <ItemsControl ItemsSource="{Binding FavoriteDevices}" ItemTemplate="{DynamicResource MainDeviceTemplate}"
                          ItemsPanel="{DynamicResource MainDevicePanel}" Margin="{DynamicResource MainItemsMargin}" MaxWidth="{DynamicResource MainRowWidth}" HorizontalAlignment="Left" />
            <TextBlock Text="{c:T 'Markeer apparaten als favoriet met de ster in hun instellingen, of klik er met de rechtermuisknop op.'}"
                       Style="{StaticResource Body}" Foreground="{DynamicResource SubTextBrush}"
                       Visibility="{Binding FavoriteDevices.Count, Converter={StaticResource Visible}, ConverterParameter=not}" />

            <TextBlock Text="{c:T 'Favoriete flows'}" Style="{StaticResource Heading}" Visibility="{Binding FavoriteFlows.Count, Converter={StaticResource Visible}}" />
            <ItemsControl ItemsSource="{Binding FavoriteFlows}" ItemTemplate="{StaticResource FlowTile}" ItemsPanel="{StaticResource WrapItems}" Margin="-4,0" />

            <TextBlock Text="{c:T Sferen}" Style="{StaticResource Heading}" Visibility="{Binding Moods.Count, Converter={StaticResource Visible}}" />
            <ItemsControl ItemsSource="{Binding Moods}" ItemTemplate="{StaticResource MoodTile}" ItemsPanel="{StaticResource WrapItems}" Margin="-4,0" />

            <TextBlock Text="{c:T 'Recente meldingen'}" Style="{StaticResource Heading}" Visibility="{Binding Notifications.Count, Converter={StaticResource Visible}}" />
            <Border Style="{StaticResource Card}" Padding="14,8" MaxWidth="760" HorizontalAlignment="Left" Visibility="{Binding Notifications.Count, Converter={StaticResource Visible}}">
                <ItemsControl x:Name="Recent">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type c:NotificationVM}">
                            <DockPanel Margin="0,5">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding TimeText}" Style="{StaticResource Sub}" Width="46" />
                                <TextBlock Text="{Binding Text}" Style="{StaticResource Body}" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
