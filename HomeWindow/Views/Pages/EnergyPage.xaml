<UserControl x:Class="HomeWindow.Views.Pages.EnergyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:HomeWindow.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,22,22,28">
        <StackPanel DataContext="{Binding Energy}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" VerticalAlignment="Center" Click="Reload_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="{c:T 'Rapport vernieuwen'}" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{c:T Energie}" Style="{StaticResource Title}" />
            </DockPanel>
            <TextBlock Text="{Binding DataContext.EnergyError, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource Body}"
                       Foreground="{DynamicResource WarnBrush}" Margin="0,8,0,0"
                       Visibility="{Binding DataContext.EnergyError, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visible}}" />

            <!-- Now -->
            <TextBlock Text="{c:T Nu}" Style="{StaticResource Heading}" />
            <UniformGrid Rows="1" Margin="0,0,-12,0">
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="{c:T Huis}" Style="{StaticResource Sub}" />
                        </StackPanel>
                        <TextBlock Text="{Binding HomeText}" Style="{StaticResource Big}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0" Visibility="{Binding HasSolar, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE706;" FontSize="13" Foreground="{DynamicResource SolarBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="{c:T Zon}" Style="{StaticResource Sub}" />
                        </StackPanel>
                        <TextBlock Text="{Binding SolarText}" Style="{StaticResource Big}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0" Visibility="{Binding HasGrid, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="13" Foreground="{DynamicResource GridBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding GridLabel}" Style="{StaticResource Sub}" />
                        </StackPanel>
                        <TextBlock Text="{Binding GridText}" Style="{StaticResource BigGridValue}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0" Visibility="{Binding HasBattery, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE83F;" FontSize="13" Foreground="{DynamicResource GoodBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding BatteryLabel}" Style="{StaticResource Sub}" />
                        </StackPanel>
                        <TextBlock Text="{Binding BatteryText}" Style="{StaticResource Big}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding BatteryChargeText}" Style="{StaticResource Sub}" Margin="0,2,0,0"
                                   Visibility="{Binding BatteryChargeText, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Totals and the last 14 days, side by side and equally high -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal">
                    <TextBlock Text="{c:T Totalen}" Style="{StaticResource Heading}" />
                    <TextBlock Text="{Binding ReportStatus}" Style="{StaticResource Sub}" Margin="12,18,0,8" VerticalAlignment="Bottom"
                               Visibility="{Binding ReportStatus, Converter={StaticResource Visible}}" />
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="120" />
                            <ColumnDefinition Width="Auto" MinWidth="96" />
                            <ColumnDefinition Width="Auto" MinWidth="96" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Column="1" Text="{c:T Vandaag}" Style="{StaticResource Sub}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="{c:T 'Deze maand'}" Style="{StaticResource Sub}" FontWeight="SemiBold" />

                        <TextBlock Grid.Row="1" Text="{c:T Verbruik}" Style="{StaticResource Body}" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TodayUse}" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding MonthUse}" FontWeight="SemiBold" Margin="0,8,0,0" />

                        <TextBlock Grid.Row="2" Text="{c:T 'Van het net'}" Style="{StaticResource Body}" Margin="0,6,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TodayImport}" Margin="0,6,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding MonthImport}" Margin="0,6,0,0" />

                        <TextBlock Grid.Row="3" Text="{c:T Teruggeleverd}" Style="{StaticResource Body}" Margin="0,6,0,0" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TodayExport}" Margin="0,6,0,0" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding MonthExport}" Margin="0,6,0,0" />

                        <TextBlock Grid.Row="4" Text="{c:T 'Zon opgewekt'}" Style="{StaticResource Body}" Margin="0,6,0,0" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TodaySolar}" Margin="0,6,0,0" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding MonthSolar}" Margin="0,6,0,0" />

                        <TextBlock Grid.Row="5" Text="{c:T 'Batterij geladen'}" Style="{StaticResource Body}" Margin="0,6,0,0" Visibility="{Binding HasBatteryTotals, Converter={StaticResource Visible}}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding TodayCharged}" Margin="0,6,0,0" Visibility="{Binding HasBatteryTotals, Converter={StaticResource Visible}}" />
                        <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding MonthCharged}" Margin="0,6,0,0" Visibility="{Binding HasBatteryTotals, Converter={StaticResource Visible}}" />

                        <TextBlock Grid.Row="6" Text="{c:T 'Batterij ontladen'}" Style="{StaticResource Body}" Margin="0,6,0,0" Visibility="{Binding HasBatteryTotals, Converter={StaticResource Visible}}" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding TodayDischarged}" Margin="0,6,0,0" Visibility="{Binding HasBatteryTotals, Converter={StaticResource Visible}}" />
                        <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding MonthDischarged}" Margin="0,6,0,0" Visibility="{Binding HasBatteryTotals, Converter={StaticResource Visible}}" />

                        <TextBlock Grid.Row="7" Text="{c:T Gas}" Style="{StaticResource Body}" Margin="0,6,0,0" Visibility="{Binding HasGas, Converter={StaticResource Visible}}" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding TodayGas}" Margin="0,6,0,0" />
                        <TextBlock Grid.Row="7" Grid.Column="2" Text="{Binding MonthGas}" Margin="0,6,0,0" />
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Border Width="9" Height="9" CornerRadius="2" Background="{DynamicResource GridBrush}" Margin="0,0,5,0" />
                                <TextBlock Text="{c:T 'Van het net'}" Style="{StaticResource Sub}" Margin="0,0,12,0" />
                                <Border Width="9" Height="9" CornerRadius="2" Background="{DynamicResource SolarBrush}" Margin="0,0,5,0" />
                                <TextBlock Text="{c:T Zon}" Style="{StaticResource Sub}" />
                            </StackPanel>
                            <TextBlock Text="{c:T 'Afgelopen 14 dagen'}" Style="{StaticResource Sub}" FontWeight="SemiBold" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Days}" Height="146">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type c:BarVM}">
                                    <DockPanel ToolTip="{Binding Tooltip}" Background="Transparent">
                                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Label}" Style="{StaticResource Sub}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                            <Border Width="7" CornerRadius="2,2,0,0" Background="{DynamicResource GridBrush}" Height="{Binding ImportHeight}" VerticalAlignment="Bottom" Margin="0,0,2,0" />
                                            <Border Width="7" CornerRadius="2,2,0,0" Background="{DynamicResource SolarBrush}" Height="{Binding SolarHeight}" VerticalAlignment="Bottom" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Devices now and today -->
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{c:T 'Grootste verbruikers nu'}" Style="{StaticResource Heading}" />
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,8">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Consumers}" ItemTemplate="{StaticResource ConsumerRow}" />
                        <TextBlock Text="{c:T '* geschat door Homey Energie'}" Style="{StaticResource Sub}" FontSize="11" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <TextBlock Grid.Column="2" Text="{c:T 'Verbruik vandaag per apparaat'}" Style="{StaticResource Heading}" />
                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Padding="14,8">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding TodayDevices}" ItemTemplate="{StaticResource ConsumerRow}" />
                        <TextBlock Text="{c:T 'Wordt geladen zodra het rapport klaar is.'}" Style="{StaticResource Sub}"
                                   Visibility="{Binding ReportLoaded, Converter={StaticResource Visible}, ConverterParameter=not}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
