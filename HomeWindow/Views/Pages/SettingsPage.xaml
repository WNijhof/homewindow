<UserControl x:Class="HomeWindow.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:HomeWindow.Core">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,7" />
            <Setter Property="LastChildFill" Value="True" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,22,22,28">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="{c:T Instellingen}" Style="{StaticResource Title}" Margin="0,0,0,6" />

            <!-- Homeys -->
            <TextBlock Text="Homey" Style="{StaticResource Heading}" />
            <ItemsControl x:Name="HomeyCards">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type c:HomeyConfig}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,10">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource Btn}" Padding="12,5" Content="{c:T Wijzigen}" Click="Edit_Click" Tag="{Binding}" />
                                    <Button Style="{StaticResource IconBtn}" Content="&#xE74D;" Margin="6,0,0,0" ToolTip="{c:T Verwijderen}" Click="Remove_Click" Tag="{Binding}" />
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE80F;" FontSize="18" Margin="0,0,12,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Sub}">
                                        <Run Text="{Binding LocalAddress, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding CloudId, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button x:Name="AddButton" Style="{StaticResource Btn}" HorizontalAlignment="Left" Click="Add_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="{c:T 'Homey toevoegen'}" />
                </StackPanel>
            </Button>

            <!-- Editor -->
            <Border x:Name="Editor" Style="{StaticResource Card}" Margin="0,8,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="EditorTitle" Text="{c:T 'Homey toevoegen'}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock DockPanel.Dock="Left" Width="150" Text="{c:T Naam}" Style="{StaticResource Label}" />
                        <TextBox x:Name="NameBox" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock DockPanel.Dock="Left" Width="150" Text="{c:T 'IP-adres (lokaal)'}" Style="{StaticResource Label}" />
                        <TextBox x:Name="AddressBox" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock DockPanel.Dock="Left" Width="150" Text="API-key" Style="{StaticResource Label}" />
                        <PasswordBox x:Name="TokenBox" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock DockPanel.Dock="Left" Width="150" Text="{c:T 'Homey-ID (cloud)'}" Style="{StaticResource Label}" />
                        <TextBox x:Name="CloudBox" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock DockPanel.Dock="Left" Width="150" Text="{c:T Verbinding}" Style="{StaticResource Label}" />
                        <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ModeAuto" Style="{StaticResource Segment}" GroupName="Mode" Content="{c:T 'Automatisch'}" />
                                <RadioButton x:Name="ModeLocal" Style="{StaticResource Segment}" GroupName="Mode" Content="{c:T 'Alleen lokaal'}" />
                                <RadioButton x:Name="ModeCloud" Style="{StaticResource Segment}" GroupName="Mode" Content="{c:T 'Alleen cloud'}" />
                            </StackPanel>
                        </Border>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="150,0,0,0"
                               Text="{c:T 'Automatisch gebruikt thuis het IP-adres en daarbuiten de cloud. Het Homey-ID vult HomeWindow zelf in na de eerste lokale verbinding.'}" />

                    <TextBlock x:Name="TestResult" Style="{StaticResource Body}" Margin="0,12,0,0" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="TestButton" Style="{StaticResource Btn}" Content="{c:T 'Verbinding testen'}" Click="Test_Click" />
                        <Button Style="{StaticResource AccentBtn}" Content="{c:T Opslaan}" Margin="8,0" Click="Save_Click" />
                        <Button Style="{StaticResource Btn}" Content="{c:T Annuleren}" Click="Cancel_Click" />
                    </StackPanel>

                    <Border Background="{DynamicResource IconBgBrush}" CornerRadius="8" Padding="12,10" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="{c:T 'Een API-key maken'}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource Body}" Foreground="{DynamicResource SubTextBrush}"
                                       Text="{c:T 'Ga naar my.homey.app, kies je Homey en open Instellingen → API-sleutels → Nieuwe API-sleutel. Geef rechten voor wat HomeWindow moet kunnen: apparaten bekijken en bedienen, zones, flows bekijken en starten, sferen, logica (variabelen), meldingen, gebruikers, energie, Insights, systeem, apps en geolocatie (weer). Het IP-adres staat in de Homey-app onder Instellingen → Algemeen.'}" />
                            <TextBlock Margin="0,6,0,0">
                                <Hyperlink NavigateUri="https://my.homey.app" RequestNavigate="Link_Navigate" Foreground="{DynamicResource AccentBrush}">my.homey.app</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <TextBlock Text="{c:T Uiterlijk}" Style="{StaticResource Heading}" Margin="2,26,0,8" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock DockPanel.Dock="Left" Width="170" Text="{c:T Thema}" Style="{StaticResource Label}" />
                        <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" x:Name="ThemeChoice">
                                <RadioButton Style="{StaticResource Segment}" GroupName="Theme" Tag="system" Content="{c:T Systeem}" Checked="Theme_Checked" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Theme" Tag="light" Content="{c:T Licht}" Checked="Theme_Checked" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Theme" Tag="dark" Content="{c:T Donker}" Checked="Theme_Checked" />
                            </StackPanel>
                        </Border>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock DockPanel.Dock="Left" Width="170" Text="{c:T Achtergrond}" Style="{StaticResource Label}" />
                        <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" x:Name="BackdropChoice">
                                <RadioButton Style="{StaticResource Segment}" GroupName="Backdrop" Tag="dashboard" Content="Dashboard" Checked="Backdrop_Checked" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Backdrop" Tag="paper" Content="{c:T Papier}" Checked="Backdrop_Checked" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Backdrop" Tag="aurora" Content="Aurora" Checked="Backdrop_Checked" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Backdrop" Tag="dusk" Content="{c:T Schemer}" Checked="Backdrop_Checked" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Backdrop" Tag="ocean" Content="{c:T Oceaan}" Checked="Backdrop_Checked" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Backdrop" Tag="glass" Content="{c:T Glas}" Checked="Backdrop_Checked" />
                            </StackPanel>
                        </Border>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock DockPanel.Dock="Left" Width="170" Text="{c:T Intensiteit}" Style="{StaticResource Label}" />
                        <Slider x:Name="IntensitySlider" Minimum="0" Maximum="1" Width="260" HorizontalAlignment="Left" ValueChanged="Appearance_Changed" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock DockPanel.Dock="Left" Width="170" Text="{c:T Tekstgrootte}" Style="{StaticResource Label}" />
                        <TextBlock DockPanel.Dock="Right" x:Name="ScaleText" Style="{StaticResource Sub}" Width="50" />
                        <Slider x:Name="ScaleSlider" Minimum="0.85" Maximum="1.3" SmallChange="0.05" LargeChange="0.05" IsSnapToTickEnabled="True" TickFrequency="0.05"
                                Width="260" HorizontalAlignment="Left" ValueChanged="Scale_Changed" PreviewMouseUp="Scale_Commit" KeyUp="Scale_Commit" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock DockPanel.Dock="Left" Width="170" Text="{c:T Schaduwen}" Style="{StaticResource Label}" />
                        <ToggleButton x:Name="ShadowSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Left" Click="Appearance_Click" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock DockPanel.Dock="Left" Width="170" Text="{c:T Tegelgrootte}" Style="{StaticResource Label}" />
                        <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" x:Name="TileSizeChoice">
                                <RadioButton Style="{StaticResource Segment}" GroupName="TileSize" Tag="small" Content="{c:T Klein}" Checked="TileSize_Checked" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="TileSize" Tag="normal" Content="{c:T Normaal}" Checked="TileSize_Checked" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="TileSize" Tag="large" Content="{c:T Groot}" Checked="TileSize_Checked" />
                            </StackPanel>
                        </Border>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock DockPanel.Dock="Left" Width="170" Text="{c:T 'Paneel bij de klok'}" Style="{StaticResource Label}" />
                        <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" x:Name="FlyoutViewChoice">
                                <RadioButton Style="{StaticResource Segment}" GroupName="FlyView" Tag="list" Content="{c:T Lijst}" Checked="FlyoutView_Checked" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="FlyView" Tag="grid" Content="{c:T Raster}" Checked="FlyoutView_Checked" />
                            </StackPanel>
                        </Border>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock DockPanel.Dock="Left" Width="170" Text="{c:T Hoofdvenster}" Style="{StaticResource Label}" />
                        <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" x:Name="MainViewChoice">
                                <RadioButton Style="{StaticResource Segment}" GroupName="MainView" Tag="grid" Content="{c:T Raster}" Checked="MainView_Checked" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="MainView" Tag="list" Content="{c:T Lijst}" Checked="MainView_Checked" />
                            </StackPanel>
                        </Border>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock DockPanel.Dock="Left" Width="170" Text="{c:T 'Weer in het paneel'}" Style="{StaticResource Label}" />
                        <ToggleButton x:Name="WeatherSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Left" Click="General_Click" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock DockPanel.Dock="Left" Width="170" Text="{c:T 'Energie in het paneel'}" Style="{StaticResource Label}" />
                        <ToggleButton x:Name="EnergySwitch" Style="{StaticResource Switch}" HorizontalAlignment="Left" Click="General_Click" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock DockPanel.Dock="Left" Width="170" Text="{c:T 'Energie in de taakbalk'}" Style="{StaticResource Label}" />
                        <ToggleButton x:Name="TaskbarSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Left" Click="General_Click" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock DockPanel.Dock="Left" Width="170" Text="{c:T 'Plaats in de taakbalk'}" Style="{StaticResource Label}" />
                        <StackPanel>
                            <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" x:Name="TaskbarPositionChoice">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="TaskbarPosition" Tag="left" Content="{c:T Links}" Checked="TaskbarPosition_Checked" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="TaskbarPosition" Tag="right" Content="{c:T Rechts}" Checked="TaskbarPosition_Checked" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{c:T 'Links past bij taakbalk-iconen in het midden. Staan die links, dan blijft de energie rechts.'}" Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- General -->
            <TextBlock Text="{c:T Algemeen}" Style="{StaticResource Heading}" Margin="2,26,0,8" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <ToggleButton x:Name="StartupSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Startup_Click" />
                        <StackPanel>
                            <TextBlock Text="{c:T 'Starten met Windows'}" Style="{StaticResource Body}" />
                            <TextBlock Text="{c:T 'HomeWindow start dan stil in het systeemvak.'}" Style="{StaticResource Sub}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <ToggleButton x:Name="HotkeySwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="General_Click" />
                        <StackPanel>
                            <TextBlock Text="{c:T Sneltoets}" Style="{StaticResource Body}" />
                            <TextBlock Text="{c:T 'Ctrl + Alt + H opent het paneel bij de klok.'}" Style="{StaticResource Sub}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <ToggleButton x:Name="ToastSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="General_Click" />
                        <StackPanel>
                            <TextBlock Text="{c:T 'Meldingen van Homey tonen'}" Style="{StaticResource Body}" />
                            <TextBlock Text="{c:T 'Nieuwe meldingen uit de tijdlijn verschijnen als Windows-melding.'}" Style="{StaticResource Sub}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <ToggleButton x:Name="AlarmSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="General_Click" />
                        <StackPanel>
                            <TextBlock Text="{c:T 'Melding bij een alarm'}" Style="{StaticResource Body}" />
                            <TextBlock Text="{c:T 'Een Windows-melding als een rookmelder, watersensor of ander alarm afgaat.'}" Style="{StaticResource Sub}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <ToggleButton x:Name="ActivitySwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="General_Click" />
                        <StackPanel>
                            <TextBlock Text="{c:T 'Ook bij beweging en deuren'}" Style="{StaticResource Body}" />
                            <TextBlock Text="{c:T 'Ook een melding als een bewegingssensor iets ziet of een deur of raam opengaat.'}" Style="{StaticResource Sub}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock DockPanel.Dock="Left" Width="170" Text="{c:T Taal}" Style="{StaticResource Label}" />
                        <StackPanel>
                            <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" x:Name="LanguageChoice">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Lang" Tag="" Content="{c:T Automatisch}" Checked="Language_Checked" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Lang" Tag="nl" Content="Nederlands" Checked="Language_Checked" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Lang" Tag="en" Content="English" Checked="Language_Checked" />
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="RestartHint" Text="{c:T 'Start HomeWindow opnieuw om de taal te wisselen.'}" Style="{StaticResource Sub}" Margin="0,6,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Updates -->
            <TextBlock Text="{c:T Updates}" Style="{StaticResource Heading}" Margin="2,26,0,8" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <ToggleButton x:Name="UpdateSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Update_Click" />
                        <StackPanel>
                            <TextBlock Text="{c:T 'Automatisch bijwerken'}" Style="{StaticResource Body}" />
                            <TextBlock Text="{c:T 'HomeWindow zoekt bij het starten en elke zes uur naar een nieuwe versie op GitHub en installeert die stil.'}" Style="{StaticResource Sub}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <Button x:Name="CheckButton" DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="{c:T 'Nu controleren'}" Click="Check_Click" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="VersionText" Style="{StaticResource Body}" />
                            <TextBlock Text="{Binding Status, Source={x:Static c:Updater.I}}" Style="{StaticResource Sub}" TextWrapping="Wrap"
                                       Visibility="{Binding Status, Source={x:Static c:Updater.I}, Converter={StaticResource Visible}}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="{c:T 'Log openen'}" Click="Log_Click" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{c:T Logbestand}" Style="{StaticResource Body}" />
                            <TextBlock Text="{c:T 'Onverwachte fouten komen in dit bestand. Stuur het mee als je een probleem meldt.'}" Style="{StaticResource Sub}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
