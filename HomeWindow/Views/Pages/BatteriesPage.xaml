<UserControl x:Class="HomeWindow.Views.Pages.BatteriesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:HomeWindow.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,22,22,28">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="{c:T Batterijen}" Style="{StaticResource Title}" Margin="0,0,0,6" />
            <TextBlock Text="{c:T 'Alle apparaten op batterijen, de leegste bovenaan. Klik op een apparaat voor meer.'}" Style="{StaticResource Sub}" Margin="0,0,0,14" />
            <ItemsControl ItemsSource="{Binding BatteryDevices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type c:DeviceVM}">
                        <Grid Margin="0,0,0,8">
                            <Border Style="{StaticResource Card}" Padding="0" />
                            <Button Style="{StaticResource TileBtn}" Command="{Binding DetailsCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Self}}">
                                <Grid Margin="12,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="180" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource DeviceIcon}" Margin="0,0,12,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource Sub}">
                                            <Run Text="{Binding ZoneName, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding BatteryTypes, Mode=OneWay, TargetNullValue='–'}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock x:Name="Level" Text="{Binding BatteryText}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        <ProgressBar x:Name="Bar" Style="{StaticResource Meter}" Value="{Binding BatteryFraction, Mode=OneWay}" Margin="0,5,0,0" Foreground="{DynamicResource GoodBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding BatteryLow}" Value="True">
                                <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource AlarmBrush}" />
                                <Setter TargetName="Level" Property="Foreground" Value="{DynamicResource AlarmBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{c:T 'Geen apparaten op batterijen gevonden'}" Style="{StaticResource Sub}" FontSize="14" Margin="0,30,0,0"
                       Visibility="{Binding BatteryDevices.Count, Converter={StaticResource Visible}, ConverterParameter=not}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
