<UserControl x:Class="HomeWindow.Views.Pages.VariablesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:HomeWindow.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,22,22,28">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="{c:T Variabelen}" Style="{StaticResource Title}" Margin="0,0,0,6" />
            <TextBlock Text="{c:T 'Logica-variabelen van je Homey. Wijzig een getal of tekst en druk op Enter of Opslaan.'}" Style="{StaticResource Sub}" Margin="0,0,0,14" TextWrapping="Wrap" />
            <TextBlock Text="{Binding VariablesError}" Style="{StaticResource Body}" Foreground="{DynamicResource WarnBrush}" Margin="0,0,0,10"
                       Visibility="{Binding VariablesError, Converter={StaticResource Visible}}" />
            <Grid Width="240" HorizontalAlignment="Left" Margin="0,0,0,12">
                <TextBox x:Name="SearchBox" Padding="30,6,30,6" TextChanged="Search_Changed" />
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="12" HorizontalAlignment="Left" Margin="11,0,0,0" Foreground="{DynamicResource SubTextBrush}" IsHitTestVisible="False" />
                <TextBlock x:Name="Hint" Text="{c:T Zoeken}" Style="{StaticResource Sub}" FontSize="13" Margin="33,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                <Button x:Name="ClearBtn" Style="{StaticResource IconBtn}" Width="24" Height="24" FontSize="10" Content="&#xE711;" HorizontalAlignment="Right" Margin="0,0,3,0" ToolTip="{c:T Wissen}" Click="ClearSearch_Click" Visibility="Collapsed" />
            </Grid>
            <ItemsControl x:Name="VarList" ItemsSource="{Binding Variables}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type c:VariableVM}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding TypeText}" Style="{StaticResource Sub}" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding BoolValue}"
                                              Visibility="{Binding IsBoolean, Converter={StaticResource Visible}}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsText, Converter={StaticResource Visible}}">
                                    <TextBox Width="260" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding SaveCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <Button Style="{StaticResource AccentBtn}" Content="{c:T Opslaan}" Margin="8,0,0,0" Command="{Binding SaveCommand}"
                                            Visibility="{Binding IsDirty, Converter={StaticResource Visible}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{c:T 'Geen variabelen gevonden'}" Style="{StaticResource Sub}" FontSize="14" Margin="0,30,0,0"
                       Visibility="{Binding Variables.Count, Converter={StaticResource Visible}, ConverterParameter=not}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
