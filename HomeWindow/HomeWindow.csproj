<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HomeWindow</AssemblyName>
    <RootNamespace>HomeWindow</RootNamespace>
    <ApplicationIcon>Assets\HomeWindow.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.4.3</Version>
    <Product>HomeWindow</Product>
    <!-- Version information in the exe and dll; files without it look suspicious to virus scanners -->
    <AssemblyTitle>HomeWindow</AssemblyTitle>
    <Company>WNijhof</Company>
    <Authors>WNijhof</Authors>
    <Copyright>Copyright © 2026 WNijhof</Copyright>
    <!-- The product version is just the version, without the commit; code signing checks it -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Description>Bedien je Homey Pro vanuit het Windows-systeemvak</Description>
    <SatelliteResourceLanguages>nl;en</SatelliteResourceLanguages>
    <!-- WPF reads the DPI awareness from the manifest; the Windows Forms analyzer does not know that -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and Windows Forms share type names; only the tray icon uses Windows Forms -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\HomeWindow.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HomeWindow.Tests" />
  </ItemGroup>

  <!-- The API client for signing in with a Homey account (Core/AthomLogin.cs), from the environment at build time
       (GitHub secrets in the release workflow), so it is not in the source. Without them that sign-in is hidden. -->
  <ItemGroup>
    <AssemblyMetadata Include="HOMEY_CLIENT_ID" Value="$(HOMEY_CLIENT_ID)" />
    <AssemblyMetadata Include="HOMEY_CLIENT_SECRET" Value="$(HOMEY_CLIENT_SECRET)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.6" />
  </ItemGroup>

</Project>
