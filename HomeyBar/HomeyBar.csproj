<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HomeyBar</AssemblyName>
    <RootNamespace>HomeyBar</RootNamespace>
    <ApplicationIcon>Assets\HomeyBar.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <Product>HomeyBar</Product>
    <Description>Bedien je Homey Pro vanuit het Windows-systeemvak</Description>
    <SatelliteResourceLanguages>nl;en</SatelliteResourceLanguages>
    <!-- WPF reads the DPI awareness from the manifest; the Windows Forms analyzer does not know that -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and Windows Forms share type names; only the tray icon uses Windows Forms -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\HomeyBar.ico" />
  </ItemGroup>

</Project>
