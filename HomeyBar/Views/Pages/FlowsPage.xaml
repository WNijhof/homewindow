<UserControl x:Class="HomeyBar.Views.Pages.FlowsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:HomeyBar.Core">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="28,22,22,8">
            <Grid DockPanel.Dock="Right" Width="240" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" Padding="30,6,8,6" TextChanged="Search_Changed" />
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="12" HorizontalAlignment="Left" Margin="11,0,0,0" Foreground="{DynamicResource SubTextBrush}" IsHitTestVisible="False" />
                <TextBlock x:Name="Hint" Text="{c:T 'Zoek een flow'}" Style="{StaticResource Sub}" FontSize="13" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{c:T Flows}" Style="{StaticResource Title}" />
                <TextBlock Text="{Binding Flows.Count}" Style="{StaticResource Sub}" FontSize="14" Margin="10,0,0,4" VerticalAlignment="Bottom" />
            </StackPanel>
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,0,22,28">
            <StackPanel>
                <TextBlock Text="{Binding FlowsError}" Style="{StaticResource Body}" Foreground="{DynamicResource WarnBrush}" Margin="0,0,0,10"
                           Visibility="{Binding FlowsError, Converter={StaticResource Visible}}" />
                <TextBlock Text="{c:T 'Alleen flows met de kaart ‘Deze flow is gestart’ kun je met de hand starten.'}" Style="{StaticResource Sub}" Margin="0,0,0,8" TextWrapping="Wrap" />
                <TextBlock Text="{c:T Favorieten}" Style="{StaticResource Heading}" Margin="2,6,0,6" Visibility="{Binding FavoriteFlows.Count, Converter={StaticResource Visible}}" />
                <ItemsControl ItemsSource="{Binding FavoriteFlows}" ItemTemplate="{StaticResource FlowTile}" ItemsPanel="{StaticResource WrapItems}" Margin="-4,0,-4,8" />
                <ItemsControl x:Name="Groups" ItemTemplate="{StaticResource FlowGroupTemplate}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
