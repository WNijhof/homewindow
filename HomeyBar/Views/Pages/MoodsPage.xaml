<UserControl x:Class="HomeyBar.Views.Pages.MoodsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:HomeyBar.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,22,22,28">
        <StackPanel>
            <TextBlock Text="{c:T Sferen}" Style="{StaticResource Title}" Margin="0,0,0,6" />
            <TextBlock Text="{c:T 'Een sfeer zet meerdere lampen en apparaten in een kamer tegelijk zoals jij ze hebt opgeslagen.'}" Style="{StaticResource Sub}" Margin="0,0,0,14" TextWrapping="Wrap" />
            <TextBlock Text="{Binding MoodsError}" Style="{StaticResource Body}" Foreground="{DynamicResource WarnBrush}" Margin="0,0,0,10"
                       Visibility="{Binding MoodsError, Converter={StaticResource Visible}}" />
            <ItemsControl ItemsSource="{Binding Moods}" ItemTemplate="{StaticResource MoodTile}" ItemsPanel="{StaticResource WrapItems}" Margin="-4,0" />
            <TextBlock Text="{c:T 'Geen sferen gevonden. Maak ze in de Homey-app bij een kamer.'}" Style="{StaticResource Sub}" FontSize="14" Margin="0,30,0,0"
                       Visibility="{Binding Moods.Count, Converter={StaticResource Visible}, ConverterParameter=not}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
