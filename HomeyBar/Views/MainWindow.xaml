<Window x:Class="HomeyBar.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:HomeyBar.Core"
        xmlns:p="clr-namespace:HomeyBar.Views.Pages"
        Title="HomeyBar" Width="1180" Height="780" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen" Icon="/Assets/HomeyBar.ico"
        Background="Transparent" FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextBrush}" UseLayoutRounding="True">
    <Grid x:Name="Root" Background="{DynamicResource BackdropBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,14,12,12">
                <StackPanel DockPanel.Dock="Top" Margin="6,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/HomeyBar.ico" Width="22" Height="22" Margin="0,0,10,0" />
                        <TextBlock Text="HomeyBar" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Homey switcher -->
                <ItemsControl x:Name="HomeyList" DockPanel.Dock="Top" Margin="0,0,0,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type c:HomeyConfig}">
                            <RadioButton Style="{StaticResource NavItem}" GroupName="Homey" Click="Homey_Click" Tag="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" FontSize="14" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Connection -->
                <Border DockPanel.Dock="Bottom" CornerRadius="8" Padding="10,8" Background="{DynamicResource IconBgBrush}" Margin="0,10,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{DynamicResource GoodBrush}" />
                            <TextBlock Text="{Binding HomeyName}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="16,2,0,0" MaxHeight="48" />
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Nav">
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="overview" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" FontSize="14" Margin="0,0,12,0" /><TextBlock Text="{c:T Overzicht}" /></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="devices" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xEA80;" FontSize="14" Margin="0,0,12,0" /><TextBlock Text="{c:T Apparaten}" /></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="flows" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE9F5;" FontSize="14" Margin="0,0,12,0" /><TextBlock Text="{c:T Flows}" /></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="moods" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE793;" FontSize="14" Margin="0,0,12,0" /><TextBlock Text="{c:T Sferen}" /></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="variables" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE9E9;" FontSize="14" Margin="0,0,12,0" /><TextBlock Text="{c:T Variabelen}" /></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="energy" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="14" Margin="0,0,12,0" /><TextBlock Text="{c:T Energie}" /></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="batteries" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE83F;" FontSize="14" Margin="0,0,12,0" /><TextBlock Text="{c:T Batterijen}" /></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="notifications" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xEA8F;" FontSize="14" Margin="0,0,12,0" /><TextBlock Text="{c:T Meldingen}" /></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="system" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" FontSize="14" Margin="0,0,12,0" /><TextBlock Text="{c:T Systeem}" /></StackPanel>
                        </RadioButton>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="6,8" />
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="settings" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="14" Margin="0,0,12,0" /><TextBlock Text="{c:T Instellingen}" /></StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Pages -->
        <Grid Grid.Column="1" x:Name="Pages">
            <p:OverviewPage x:Name="OverviewPage" />
            <p:DevicesPage x:Name="DevicesPage" Visibility="Collapsed" />
            <p:FlowsPage x:Name="FlowsPage" Visibility="Collapsed" />
            <p:MoodsPage x:Name="MoodsPage" Visibility="Collapsed" />
            <p:VariablesPage x:Name="VariablesPage" Visibility="Collapsed" />
            <p:EnergyPage x:Name="EnergyPage" Visibility="Collapsed" />
            <p:BatteriesPage x:Name="BatteriesPage" Visibility="Collapsed" />
            <p:NotificationsPage x:Name="NotificationsPage" Visibility="Collapsed" />
            <p:SystemPage x:Name="SystemPage" Visibility="Collapsed" />
            <p:SettingsPage x:Name="SettingsPage" Visibility="Collapsed" />

            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20" CornerRadius="10" Padding="14,10" MaxWidth="560"
                    Background="{DynamicResource AlarmBrush}" Visibility="{Binding Error, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding Error}" Foreground="White" FontSize="13" TextWrapping="Wrap" />
            </Border>
        </Grid>

        <!-- Device details next to the grid -->
        <Border x:Name="DetailPanel" Grid.Column="2" Width="340" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="18,14,10,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Content="&#xE711;" Click="CloseDetail_Click" ToolTip="{c:T Sluiten}" />
                    <TextBlock Text="{c:T Apparaat}" Style="{StaticResource Sub}" VerticalAlignment="Center" FontSize="12.5" />
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,4,12,20">
                    <ContentPresenter x:Name="DetailContent" ContentTemplate="{StaticResource DeviceDetail}" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
